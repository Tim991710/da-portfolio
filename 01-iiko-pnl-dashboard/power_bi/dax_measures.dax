// dax_measures.dax
// Библиотека мер для модели «План-факт P&L сети точек».
// Модель-звезда:
//   fact_sales   1—*  dim_date (по date_key)
//   fact_sales   1—*  dim_outlet (по outlet_code)
//   fact_sales   1—*  dim_dish (по dish_code)
//   fact_payroll *—1  dim_date (по month_start), dim_outlet
//   fact_plan    *—1  dim_date (по month_start), dim_outlet
// Связи: dim_date -> факты, направление фильтра одно (single).
// ВАЖНО: связь fact_payroll/fact_plan с dim_date идёт по month_start (первое
// число месяца), иначе ФОТ и план не сложатся с выручкой по месяцам.

// ---------- Базовые величины ----------

Выручка =
SUM ( fact_sales[amount_paid] )

Себестоимость =
SUM ( fact_sales[cost_sum] )

Скидки =
SUM ( fact_sales[discount_sum] )

Чеков =
DISTINCTCOUNT ( fact_sales[order_id] )

Средний чек =
DIVIDE ( [Выручка], [Чеков] )

Валовая прибыль =
[Выручка] - [Себестоимость]

ФОТ =
SUM ( fact_payroll[accrual] )

План выручки =
SUM ( fact_plan[revenue_plan] )

План ФОТ =
SUM ( fact_plan[payroll_plan] )

// ---------- Относительные показатели ----------
// DIVIDE вместо «/»: при нулевом знаменателе вернёт BLANK, а не ошибку.
// Именно поэтому месяц без выгрузки ФОТ не превращается в 0% и не тянет
// среднее вниз — на дашборде он остаётся пустым.

Food cost % =
DIVIDE ( [Себестоимость], [Выручка] )

Маржинальность % =
DIVIDE ( [Валовая прибыль], [Выручка] )

Доля ФОТ % =
DIVIDE ( [ФОТ], [Выручка] )

// Допущение: операционная рентабельность без аренды, коммуналки и прочих
// расходов — только food cost и ФОТ. Зафиксировано в README.
Операционная рентабельность % =
DIVIDE ( [Валовая прибыль] - [ФОТ], [Выручка] )

Доля скидок % =
DIVIDE ( [Скидки], [Выручка] )

// ---------- План-факт ----------

Отклонение выручки ₽ =
[Выручка] - [План выручки]

Отклонение выручки % =
DIVIDE ( [Выручка] - [План выручки], [План выручки] )

Выполнение плана % =
DIVIDE ( [Выручка], [План выручки] )

Плановая доля ФОТ % =
DIVIDE ( [План ФОТ], [План выручки] )

Отклонение доли ФОТ, п.п. =
( [Доля ФОТ %] - [Плановая доля ФОТ %] ) * 100

Отклонение ФОТ ₽ =
[ФОТ] - [План ФОТ]

// ---------- Декомпозиция отклонения доли ФОТ ----------
// Два фактора в сумме дают ровно [Отклонение доли ФОТ, п.п.]:
//   1) выручка отклонилась от плана при плановом ФОТ;
//   2) ФОТ отклонился от плана при фактической выручке.

Отклонение доли ФОТ за счёт выручки, п.п. =
( DIVIDE ( [План ФОТ], [Выручка] ) - [Плановая доля ФОТ %] ) * 100

Отклонение доли ФОТ за счёт ФОТ, п.п. =
( [Доля ФОТ %] - DIVIDE ( [План ФОТ], [Выручка] ) ) * 100

// ---------- Контекст фильтрации ----------

// Доля точки в выручке сети: ALL снимает фильтр по точкам, но сохраняет
// фильтры по периоду и блюдам.
Доля точки в выручке сети % =
DIVIDE ( [Выручка], CALCULATE ( [Выручка], ALL ( dim_outlet ) ) )

// ALLSELECTED — доля внутри выбранного пользователем среза, а не всей сети.
Доля в выбранном срезе % =
DIVIDE ( [Выручка], CALCULATE ( [Выручка], ALLSELECTED ( dim_outlet ) ) )

// Накопительный итог: окно от начала выбранного периода до текущей даты.
Выручка накопительно =
CALCULATE (
    [Выручка],
    FILTER (
        ALLSELECTED ( dim_date[date_key] ),
        dim_date[date_key] <= MAX ( dim_date[date_key] )
    )
)

Выручка год к году =
CALCULATE ( [Выручка], SAMEPERIODLASTYEAR ( dim_date[date_key] ) )

Выручка MoM % =
VAR prev = CALCULATE ( [Выручка], DATEADD ( dim_date[date_key], -1, MONTH ) )
RETURN DIVIDE ( [Выручка] - prev, prev )

// ---------- Флаги для условного форматирования ----------

Статус плана =
SWITCH (
    TRUE (),
    NOT ISINSCOPE ( dim_outlet[outlet_code] ), BLANK (),
    [Выполнение плана %] >= 1, "план выполнен",
    [Выполнение плана %] >= 0.95, "в пределах 5%",
    "ниже плана"
)

Цвет отклонения ФОТ =
IF ( [Отклонение доли ФОТ, п.п.] > 2, "#C0392B", "#1E8449" )

// ---------- Форматы ----------
// Выручка, Себестоимость, ФОТ, Валовая прибыль, план/факт в ₽  -> # ##0 " ₽"
// Все % -> 0,0 %
// Отклонение доли ФОТ, п.п. -> +0,0 " п.п.";-0,0 " п.п."
// Чеков -> # ##0
